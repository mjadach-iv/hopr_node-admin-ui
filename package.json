{
  "name": "node-admin-ui",
  "version": "5.0.1",
  "productName": "HOPR Node Admin",
  "private": true,
  "description": "Admin UI for HOPR nodes, as a web app and a desktop app",
  "author": "mjadach-iv",
  "homepage": "https://github.com/mjadach-iv/hopr_node-admin-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjadach-iv/hopr_node-admin-ui.git"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11"
  },
  "scripts": {
    "dev": "vite",
    "dev:clean": "pnpm dev --force",
    "build-vite": "tsc && vite build",
    "build": "tsc && vite build",
    "test": "echo \"Error: no test specified\" && exit 0",
    "serve": "vite preview --port 3000",
    "format": "prettier --write src/ electron/ .github/ *.ts *.json *.yml *.md",
    "format:ci": "prettier --check src/ electron/ .github/ *.ts *.json *.yml *.md",
    "lint": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\" \"electron/**/*.ts\"",
    "lint:ci": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"electron/**/*.ts\"",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:localhost:5173 && pnpm electron:compile && ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "electron:pack": "pnpm build && pnpm electron:compile && electron-builder --dir",
    "electron:build": "pnpm build && pnpm electron:compile && electron-builder --publish never"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^5.0.0",
    "@hoprnet/hopr-sdk": "5.0.0-rc.0-commit.1a334cf",
    "@metamask/jazzicon": "^2.0.0",
    "@mui/icons-material": "^5.11.16",
    "@mui/material": "^5.13.0",
    "@reduxjs/toolkit": "^1.9.5",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@types/canvas-confetti": "^1.6.0",
    "@types/jest": "^27.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.14.197",
    "@types/md5": "^2.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-timeago": "^4.1.4",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "canvas-confetti": "^1.6.0",
    "concurrently": "^10.0.6",
    "dayjs": "^1.11.9",
    "electron": "^44.9.2",
    "electron-builder": "^26.18.0",
    "eslint": "^8.42.0",
    "eslint-plugin-import-newlines": "^1.3.1",
    "eslint-plugin-newline-destructuring": "^1.2.1",
    "eslint-plugin-react": "^7.33.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "numbro": "^2.5.0",
    "prettier": "^2.8.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-redux": "^9.2.0",
    "react-router-dom": "7.15.0",
    "react-timeago": "^7.2.0",
    "react-toastify": "11.0.5",
    "react-virtuoso": "^4.18.12",
    "redux": "^4.2.1",
    "typescript": "^5.1.6",
    "uuid": "^9.0.1",
    "viem": "^2.44.4",
    "vite": "^8.0.12",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-svgr": "^5.2.0",
    "wait-on": "^9.5.1",
    "web-vitals": "^2.1.0"
  }
}
